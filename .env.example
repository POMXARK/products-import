# --- Приложение ---
APP_ENV=prod
APP_DEBUG=0
LOG_LEVEL=info
# Порт, на котором nginx открывает фронтенд и API
HTTP_PORT=8080

# --- PostgreSQL ---
POSTGRES_DB=products
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://app:change-me@db:5432/products?serverVersion=16&charset=utf8

# --- RabbitMQ / Symfony Messenger ---
RABBITMQ_USER=app
RABBITMQ_PASSWORD=change-me
# Порт веб-консоли RabbitMQ на localhost
RABBITMQ_MANAGEMENT_PORT=15672
MESSENGER_TRANSPORT_DSN=amqp://app:change-me@rabbitmq:5672/%2f/imports
MESSENGER_FAILED_TRANSPORT_DSN=amqp://app:change-me@rabbitmq:5672/%2f/imports_failed
MESSENGER_MAX_RETRIES=3
MESSENGER_RETRY_DELAY_MS=2000

# --- JWT: не короче 32 байт, сгенерировать: openssl rand -base64 48 ---
JWT_SECRET=
JWT_TTL=3600

# --- Учётка для входа (создаётся при старте контейнером migrate) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# --- Импорт ---
IMPORT_MAX_FILE_BYTES=10485760
IMPORT_RATE_LIMIT=5
IMPORT_RATE_INTERVAL="1 minute"
IMPORT_PROGRESS_EVERY_ROWS=5

# --- Скачивание изображений ---
IMAGE_MAX_BYTES=10485760
IMAGE_TIMEOUT_SECONDS=15
# 1 разрешает скачивать из приватных сетей (только для локальных тестов; защита от SSRF)
IMAGE_ALLOW_PRIVATE_NETWORK=0
