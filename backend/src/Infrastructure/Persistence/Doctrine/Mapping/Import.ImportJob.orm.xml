<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Domain\Import\ImportJob" table="import_jobs">
        <indexes>
            <index name="idx_import_jobs_created_at" columns="created_at"/>
        </indexes>
        <id name="id" type="guid"/>
        <field name="originalFilename" column="original_filename" length="255"/>
        <field name="storedPath" column="stored_path" length="512"/>
        <field name="createdBy" column="created_by" type="integer" nullable="true"/>
        <field name="status" length="16" enum-type="App\Domain\Import\ImportStatus"/>
        <field name="totalRows" column="total_rows" type="integer" nullable="true"/>
        <field name="processedRows" column="processed_rows" type="integer"/>
        <field name="createdCount" column="created_count" type="integer"/>
        <field name="updatedCount" column="updated_count" type="integer"/>
        <field name="failedCount" column="failed_count" type="integer"/>
        <field name="issues" type="json"/>
        <field name="issuesTruncated" column="issues_truncated" type="boolean"/>
        <field name="failureReason" column="failure_reason" type="text" nullable="true"/>
        <field name="startedAt" column="started_at" type="datetime_immutable" nullable="true"/>
        <field name="finishedAt" column="finished_at" type="datetime_immutable" nullable="true"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
    </entity>
</doctrine-mapping>
